{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "objective_dependency_dag",
  "type": "object",
  "required": ["version", "scope_id", "nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "scope_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["objective_id"],
        "properties": { "objective_id": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
