{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validation_report",
  "type": "object",
  "required": ["version", "artifacts"],
  "properties": {
    "version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "schema", "valid"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "schema": { "type": "string" },
          "valid": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
