{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "math_inference_rules",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["math_topic_id", "keywords", "min_hits", "confidence"],
        "properties": {
          "math_topic_id": { "type": "string" },
          "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "min_hits": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
