{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "math_recall_map",
  "type": "object",
  "required": ["version", "scope_id", "mappings"],
  "properties": {
    "version": { "type": "string" },
    "scope_id": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective_id", "math_recalls"],
        "properties": {
          "objective_id": { "type": "string" },
          "math_recalls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["math_topic_id", "recall_only", "confidence", "evidence"],
              "properties": {
                "math_topic_id": { "type": "string" },
                "recall_only": { "type": "boolean", "const": true },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["kind", "ref"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["pointer_anchor", "lexical_match"] },
                      "ref": {
                        "type": "object",
                        "required": ["source", "anchor"],
                        "properties": {
                          "source": { "type": "string" },
                          "anchor": { "type": "string" }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
