{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pointer_map",
  "type": "object",
  "required": ["version", "scope_id", "mappings"],
  "properties": {
    "version": { "type": "string" },
    "scope_id": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective_id", "pointer_refs"],
        "properties": {
          "objective_id": { "type": "string" },
          "pointer_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "anchor", "role"],
              "properties": {
                "source": { "type": "string" },
                "anchor": { "type": "string" },
                "role": { "type": "string", "enum": ["clarify", "constrain", "example"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
