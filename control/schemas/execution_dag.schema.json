{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "execution_dag",
  "type": "object",
  "required": ["version", "scope_id", "nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "scope_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "kind"],
        "properties": {
          "node_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["build_step", "artifact", "stop_terminal"] },
          "produces": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
