{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "formal_objectives",
  "type": "object",
  "required": ["version", "scope_id", "objectives"],
  "properties": {
    "version": { "type": "string" },
    "scope_id": { "type": "string" },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["objective_id", "title", "capability", "authority_refs"],
        "properties": {
          "objective_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "scope_flags": { "type": "array", "items": { "type": "string" } },
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "anchor"],
              "properties": {
                "source": { "type": "string" },
                "anchor": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
