{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "math_topic_index",
  "type": "object",
  "required": ["version", "source", "topics"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["math_topic_id", "title", "keywords", "source_ref"],
        "properties": {
          "math_topic_id": { "type": "string", "pattern": "^[a-z0-9._:-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_ref": {
            "type": "object",
            "required": ["source", "anchor"],
            "properties": {
              "source": { "type": "string" },
              "anchor": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
