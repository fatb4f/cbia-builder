{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repo Mode B Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "mode",
    "allowed_roots",
    "builder_snapshot",
    "consumer_view",
    "forbidden_globs",
    "evidence_outputs"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "const": "B"
    },
    "allowed_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "builder_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "required_paths"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "required_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "consumer_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "material_root"
      ],
      "properties": {
        "manifest_path": {
          "type": "string"
        },
        "material_root": {
          "type": "string"
        }
      }
    },
    "forbidden_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_mode_b_check"
      ],
      "properties": {
        "repo_mode_b_check": {
          "type": "string"
        }
      }
    }
  }
}
